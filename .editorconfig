root = true

[*]
charset = utf-8
insert_final_newline = true

# Match the original Holub source format so diffs against it stay clean
[*.java]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = crlf
trim_trailing_whitespace = false

[*.txt]
end_of_line = crlf

# Files added by the team
[*.{md,sh}]
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
